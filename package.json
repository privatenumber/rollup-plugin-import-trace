{
	"name": "rollup-plugin-import-trace",
	"version": "0.0.0-semantic-release",
	"description": "Rollup/Vite plugin to track import chains for better error debugging",
	"keywords": [
		"rollup",
		"rollup-plugin",
		"vite",
		"vite-plugin",
		"import",
		"trace",
		"debug",
		"error"
	],
	"license": "MIT",
	"repository": "privatenumber/rollup-plugin-import-trace",
	"funding": "https://github.com/privatenumber/rollup-plugin-import-trace?sponsor=1",
	"author": {
		"name": "Hiroki Osame",
		"email": "hiroki.osame@gmail.com"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		"types": "./dist/index.d.ts",
		"import": "./dist/index.mjs",
		"require": "./dist/index.cjs"
	},
	"packageManager": "pnpm@12.16.1",
	"scripts": {
		"build": "pkgroll --minify",
		"test": "pnpm build && node tests/index.ts",
		"lint": "lintroll --cache --node .",
		"type-check": "tsc",
		"prepack": "pnpm build && clean-pkg-json"
	},
	"engines": {
		"node": ">=20.20.0"
	},
	"peerDependencies": {
		"rollup": "^3.0.0 || ^4.0.0",
		"vite": "^5.0.0 || ^6.0.0 || ^7.0.0"
	},
	"peerDependenciesMeta": {
		"rollup": {
			"optional": true
		},
		"vite": {
			"optional": true
		}
	},
	"devDependencies": {
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@types/node": "^22.14.1",
		"clean-pkg-json": "^2.1.0",
		"fs-fixture": "^2.16.0",
		"lintroll": "^1.34.1",
		"manten": "^2.0.2",
		"nano-spawn": "^2.1.0",
		"pkgroll": "^2.29.0",
		"rollup": "^4.67.5",
		"typescript": "^6.0.3",
		"vite": "^7.3.7"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "26.13.0",
			"onFail": "download"
		}
	}
}
