{
	"compilerOptions": {
		// engines.node >=20.20
		"target": "ES2022",
		"moduleDetection": "force",
		"module": "Preserve",
		"resolveJsonModule": true,
		"types": [
			"node",
		],
		"allowImportingTsExtensions": true,
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
	},
}
